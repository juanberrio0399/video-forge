# === Oddly Clipper — credenciales (copia este archivo a .env y llena tus valores) ===
# El PC solo necesita ESTAS 3 (todas gratis). El .env NUNCA se sube a GitHub (esta en .gitignore).
# YouTube lo sube la NUBE despues de que apruebes en el bot -> aqui NO va el token de YouTube.

# --- IA que elige los mejores momentos (Google AI Studio, gratis) ---
GEMINI_API_KEY=

# --- B-roll (Pexels, plan gratis) ---
PEXELS_API_KEY=

# --- Cloudflare R2 (para dejar el Short editado que revisa el bot) ---
# Crea un token en: Cloudflare -> R2 -> "Manage R2 API Tokens" -> Create (permiso: Object Read & Write,
# solo el bucket 'video-forge'). Te da el Access Key ID y el Secret Access Key (el Secret se ve 1 sola vez).
CLOUDFLARE_ACCOUNT_ID=931d2b986dd9c0fd4ead3b4dd953e347
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-forge

# --- Opcional: forzar dispositivo (auto | cpu | cuda). Por defecto auto-detecta. ---
DEVICE=auto
