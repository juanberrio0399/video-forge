# === Oddly Clipper — credenciales (copia este archivo a .env y llena tus valores) ===
# TODO es de planes GRATIS. El .env NUNCA se sube a GitHub (está en .gitignore).

# --- Subir a Oddly Loop (canal YT2) ---
YT2_CLIENT_ID=
YT2_CLIENT_SECRET=
YT2_REFRESH_TOKEN=

# --- IA para elegir los mejores momentos (Gemini, plan gratis) ---
GEMINI_API_KEY=

# --- B-roll (Pexels, plan gratis) ---
PEXELS_API_KEY=

# --- Cloudflare R2 (para etiquetar la categoría que lee el bot) ---
# Usa un token R2 de solo-escritura al bucket video-forge.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-forge

# --- Aviso al bot de Telegram (mismo bot de video-forge) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opcional: forzar dispositivo (auto | cpu | cuda). Por defecto auto-detecta. ---
DEVICE=auto
